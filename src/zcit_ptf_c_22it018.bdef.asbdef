projection;
strict ( 2 );
use draft;

define behavior for ZCIT_PTF_C_22IT018 alias PortfolioHdr
{
  use create;
  use update;
  use delete;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;
  use action Resume;
  use association _stockitem { create; with draft; }
}

define behavior for ZCIT_STK_C_22IT018 alias StockItem
{
  use update;
  use delete;
  use association _portfolio { with draft; }
}